{
  "name": "autostack-ai",
  "version": "1.0.0",
  "description": "One command. Full AI-powered dev stack.",
  "type": "module",
  "bin": {
    "autostack-ai": "./dist/cli/index.js"
  },
  "main": "./dist/core/engine/engine.js",
  "files": [
    "dist",
    "skills",
    "workflows",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "link": "pnpm build && pnpm link --global",
    "prepack": "pnpm build"
  },
  "dependencies": {
